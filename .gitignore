# ============================================================
# FoldLens .gitignore
# 原则：源码、文档、样例数据、锁文件入库；
#       依赖、构建产物、缓存、本地工具、密钥不入库。
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.directory

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache
.oxlintcache

# ---------- Python / 后端 ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
*.egg-info/
.eggs/
build/
.uv-cache/

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 应用运行时缓存 ----------
# 运行时下载的 PDB 结构与元数据；样例结构在 data/samples/ 中，必须入库
.cache/
backend/.cache/
data/cache/
*.sqlite
*.sqlite3

# ---------- 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ---------- 测试 / 设计检查产物 ----------
.taste-skill/
test-results/
playwright-report/
playwright/.cache/

# ---------- 本地 AI / 设计工具链 ----------
# 这些目录约 50MB（含平台二进制），且属于本机环境；
# 版本清单见根目录 skills-lock.json，恢复方式见 docs/ENVIRONMENT.md。
.claude/
.agents/
.codex/
.impeccable/

# 注意：skills-lock.json 位于根目录，必须入库，不要忽略。
